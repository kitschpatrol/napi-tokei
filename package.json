{
  "name": "@kitschpatrol/tokei",
  "version": "2.1.0",
  "description": "Node bindings for Tokei, a fast code counting tool.",
  "keywords": [
    "tokei",
    "loc",
    "lines-of-code",
    "code-stats",
    "napi",
    "napi-rs",
    "node-addon",
    "node-addon-api",
    "rust",
    "npm-package"
  ],
  "homepage": "https://github.com/kitschpatrol/napi-tokei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitschpatrol/napi-tokei.git"
  },
  "license": "MIT",
  "author": {
    "name": "Eric Mika",
    "email": "eric@ericmika.com",
    "url": "https://ericmika.com"
  },
  "sideEffects": false,
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build:debug": "node ./scripts/build.mjs",
    "build": "node ./scripts/build.mjs --release",
    "clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
    "format:oxfmt": "oxfmt",
    "format:readme": "mdat",
    "format:rs": "cargo fmt",
    "format": "run-p format:oxfmt format:rs format:readme",
    "lint:oxlint": "oxlint",
    "lint:readme": "mdat check",
    "lint": "run-p lint:oxlint lint:readme",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "version": "napi version",
    "release": "bumpp --commit %s package.json Cargo.toml index.js"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json|toml)": [
      "oxfmt --write"
    ]
  },
  "ava": {
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "extensions": [
      "ts"
    ],
    "files": [
      "__test__/**/*.spec.ts"
    ],
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ],
    "timeout": "2m",
    "workerThreads": false
  },
  "devDependencies": {
    "@kitschpatrol/remark-config": "^8.14.0",
    "@napi-rs/cli": "^3.10.8",
    "@oxc-node/core": "^0.1.4",
    "ava": "^8.0.1",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mdat": "^3.6.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "shx": "^0.4.0",
    "tinybench": "^6.2.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  },
  "napi": {
    "binaryName": "tokei",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-freebsd"
    ]
  }
}
